
# ================================================================
# DRINKING WATER BOTTLE DATASET GENERATOR
# Dataset size: 1 Crore (10,000,000) rows
# Columns: Exactly 55
# Format: Multiple CSV files
# Platform: Python, Jupyter Notebook, Google Colab, Windows
# ================================================================

import os
import random
import time
from pathlib import Path
from datetime import datetime

import numpy as np
import pandas as pd

# ================================================================
# 1. CONFIGURATION
# ================================================================

TOTAL_ROWS = 10_000_000
CHUNK_SIZE = 250_000
OUTPUT_DIR = Path("Drinking_Water_Dataset")
RANDOM_SEED = 42

START_DATE = "2023-01-01"
END_DATE = "2026-10-25"

SAVE_CSV = True
SAVE_PARQUET = False  # Set True if pyarrow is installed

OUTPUT_DIR.mkdir(parents=True, exist_ok=True)

random.seed(RANDOM_SEED)
np.random.seed(RANDOM_SEED)

rng = np.random.default_rng(RANDOM_SEED)

print("=" * 70)
print("DRINKING WATER DATASET GENERATOR")
print("=" * 70)
print(f"Target rows : {TOTAL_ROWS:,}")
print(f"Chunk size  : {CHUNK_SIZE:,}")
print(f"Output      : {OUTPUT_DIR.resolve()}")
print()


